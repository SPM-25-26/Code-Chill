{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/chillcode.db"
  },
  "ExternalApi": {
    "BaseUrl": "https://api.example.com/"
  },
  "Email": {
    "FromName": "ChillCode (Dev)",
    "FromEmail": "no-reply@example.com",
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseStartTls": true,
    "SmtpUser": "",
    "SmtpPassword": "",
    "BrandName": "ChillCode",
    "SupportEmail": "support@example.com",
    "UnsubscribeUrl": "https://example.com/unsubscribe",
    "VerificationBaseUrl": "https://example.com/verify"
  },
  "Jwt": {
    "Issuer": "ChillCodeBackend",
    "Audience": "ChillCodeFrontend",
    "SigningKey": "change-me-please-super-secret-key",
    "ExpiresInMinutes": 60,
    "RefreshTokenExpiresInDays": 7
  }
}
